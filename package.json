{
  "name": "firecrawl-agent",
  "version": "1.0.0",
  "description": "CLI tool for web scraping and crawling using Firecrawl",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "firecrawl": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target node",
    "start": "bun run src/cli.ts"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^1.19.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  },
  "keywords": ["firecrawl", "scrape", "crawl", "web", "cli"],
  "author": "Albert Solana <iamtxena@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamtxena/firecrawl-agent.git"
  }
}
